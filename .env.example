MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DBNAME=fitness_app
# Login for the web UI and the API (HTTP Basic Auth). Required; use a long random password.
AUTH_USER=
AUTH_PASSWORD=
# One port serves both the web UI (/) and the JSON API (/api)
PORT=8090
# Address to listen on; leave empty to listen on all interfaces
BIND_ADDR=
# Where the in-progress workout is kept, so it survives a restart.
SESSION_FILE=data/live-session.json
# Optional: seed exercises from this file instead of the list built into the binary
# EXERCISES_JSON_PATH=
# Optional: point the UI at an API elsewhere (default: this process, over loopback)
# BACKEND_URL=
# Optional: show generated demo data on the analytics pages
# MOCK_ANALYTICS=1
